pipeline {
  agent any
  stages {
    stage ('Checkout'){
      Steps {
         echo 'starting the pipeline'
      }
    }
    stage ('build'){
      steps {
        echo 'Building the application'
        sh 'hostname'
        sh 'whoami'
        sh 'pwd'
      }
    }
    Stage ('Test'){
      steps {
        echo 'Testing completed succesfully'
      }
    }
  }
  post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the Console Output.'
        }
    }
}
